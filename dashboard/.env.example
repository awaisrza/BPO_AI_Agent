# From Supabase → Settings → API (NOT the dashboard browser URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Agent script loading (Settings → API → service_role — keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional ViciDial fallback for API routes (Integrations save is preferred)
# VICIDIAL_BASE_URL=http://178.238.231.150
# VICIDIAL_API_USER=6666
# VICIDIAL_API_PASS=

# Optional — wake GPU workers immediately when you click Run (otherwise poll every ~20s)
# GPU_SUPERVISOR_URL=http://YOUR_GPU_IP:8770
# GPU_SUPERVISOR_SECRET=optional-shared-secret
