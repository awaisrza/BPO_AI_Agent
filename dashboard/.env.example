# From Supabase → Settings → API (NOT the dashboard browser URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Agent script loading (Settings → API → service_role — keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional ViciDial fallback for API routes (Integrations save is preferred)
# VICIDIAL_BASE_URL=http://169.58.105.180
# VICIDIAL_API_USER=6666
# VICIDIAL_API_PASS=

# GPU supervisor — instant worker sync when BPO clicks Run (port 8770 on GPU; omit if not publicly exposed)
# GPU_SUPERVISOR_URL=http://YOUR_GPU_IP:8770
# GPU_SUPERVISOR_SECRET=optional-shared-secret
# RunPod auto-resume (optional — used by Run campaign via full orchestrator)
# RUNPOD_API_KEY=
# RUNPOD_POD_ID=
# GPU_STOP_POD_ON_IDLE=false
# Public fleet worker /health (Vast public port → internal 10200). Required for Test dial wait-for-ready.
# GPU_WORKER_HEALTH_URL=http://79.116.54.219:53512/health
# Max time to wait for "ready": true before adding lead to hopper (ms)
# GPU_WORKER_READY_TIMEOUT_MS=45000
# Poll interval while waiting (ms)
# GPU_WORKER_READY_POLL_MS=2000
