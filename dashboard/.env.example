# From Supabase → Settings → API (NOT the dashboard browser URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Agent script loading (Settings → API → service_role — keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional ViciDial fallback for API routes (Integrations save is preferred)
# VICIDIAL_BASE_URL=http://169.58.105.180
# VICIDIAL_API_USER=6666
# VICIDIAL_API_PASS=

# GPU supervisor — instant worker sync + live prewarm logs
# Vast: map PUBLIC port → INTERNAL 8770 (e.g. 53604→8770). Not 53604→53604.
# GPU_SUPERVISOR_URL=http://79.116.20.245:53604
# GPU_SUPERVISOR_SECRET=same-secret-as-gpu-agent-env
# Public fleet worker /health (Vast public port → internal 10200). Required for Test dial.
# GPU_WORKER_HEALTH_URL=http://79.116.20.245:53512/health
# Vast.ai — start/resume instance from dashboard when worker is offline
# VAST_API_KEY=from-https://cloud.vast.ai/manage-keys/
# VAST_INSTANCE_ID=46827674
# Optional: stop Vast/RunPod when last campaign pauses
# GPU_STOP_POD_ON_IDLE=true
# GPU_HEALTH_TIMEOUT_MS=300000
# RunPod alternate (instead of Vast):
# RUNPOD_API_KEY=
# RUNPOD_POD_ID=
# Max time Test dial waits for prewarm (ms) — client polls up to 15 min by default
# GPU_WORKER_PREWARM_TIMEOUT_MS=900000
# Fail fast when worker is unreachable and supervisor URL is unset (ms)
# GPU_WORKER_OFFLINE_FAIL_FAST_MS=5000
# Max wait for supervisor to spawn a worker when GPU_SUPERVISOR_URL is set (ms)
# GPU_SUPERVISOR_SPAWN_WAIT_MS=90000
# Poll interval while waiting (ms)
# GPU_WORKER_READY_POLL_MS=3000
