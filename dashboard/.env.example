# From Supabase → Settings → API (NOT the dashboard browser URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Agent script loading (Settings → API → service_role — keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GPU auto-start when customer clicks "Run campaign"
# Public URL of the fleet supervisor on your RunPod pod (port 8770 proxy)
GPU_SUPERVISOR_URL=https://YOUR_POD_ID-8770.proxy.runpod.net
# Shared secret — must match GPU_SUPERVISOR_SECRET on the pod
GPU_SUPERVISOR_SECRET=generate-a-long-random-string
# RunPod — wakes the GPU pod when a campaign starts
RUNPOD_API_KEY=
RUNPOD_POD_ID=
# Stop the RunPod pod when no campaigns are running (saves cost)
GPU_STOP_POD_ON_IDLE=false
# How long to wait for pod + supervisor to come online (ms)
GPU_HEALTH_TIMEOUT_MS=300000

# Optional ViciDial fallback for API routes (Integrations save is preferred)
# VICIDIAL_BASE_URL=http://178.238.231.150
# VICIDIAL_API_USER=6666
# VICIDIAL_API_PASS=
