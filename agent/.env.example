# AI providers
# VOICE_BACKEND=managed   → Deepgram + Fish (no GPU)
# VOICE_BACKEND=chatterbox → Whisper + Chatterbox Turbo on GPU (recommended)
# VOICE_BACKEND=gpu        → Whisper + Piper (legacy, less human)
VOICE_BACKEND=chatterbox

DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
FISH_AUDIO_API_KEY=

# Fish Audio voice/model (managed backend only)
FISH_AUDIO_MODEL=s1
FISH_AUDIO_REFERENCE_ID=

# GPU backend — faster-whisper STT (pip install "pipecat-ai[whisper]")
WHISPER_MODEL=distil-large-v2
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8_float16

# Chatterbox Turbo (VOICE_BACKEND=chatterbox) — free zero-shot clone from WAV
CHATTERBOX_REFERENCE_AUDIO=
CHATTERBOX_DEVICE=cuda
CHATTERBOX_EXAGGERATION=0.35
CHATTERBOX_CFG_WEIGHT=0.5
CHATTERBOX_NORM_LOUDNESS=true

# Speech renderer (all FSM + Gemini + KB replies before TTS)
SPEECH_MAX_WORDS=14
SPEECH_PAUSE_MIN_MS=400
SPEECH_PAUSE_MAX_MS=700

# Phone/PSTN — shorter pauses, more natural live-call pacing
TELEPHONY_SPEECH_MAX_WORDS=16
TELEPHONY_PAUSE_MIN_MS=120
TELEPHONY_PAUSE_MAX_MS=220
TELEPHONY_CHATTERBOX_EXAGGERATION=0.45

# Piper (VOICE_BACKEND=gpu only)
# Leave PIPER_EXE empty to auto-detect agent/piper/piper.exe
PIPER_EXE=
PIPER_MODEL=
PIPER_SPEAKER=0

# LLM
GEMINI_MODEL=gemini-2.5-flash-lite

# ViciDial (the BPO's dialer)
VICIDIAL_BASE_URL=https://dialer.example.com
VICIDIAL_API_USER=
VICIDIAL_API_PASS=
# Closer group / preset the warm transfer should land on
VICIDIAL_TRANSFER_PRESET=CLOSER

# Where the bot's media socket listens (wired to ViciDial/SIP media)
AGENT_HOST=0.0.0.0
AGENT_PORT=8765

# Supabase — load scripts saved in the dashboard (service role, keep secret)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Daily.co — phone browser calls without Twilio/tunnel (https://dashboard.daily.co)
DAILY_API_KEY=

# Browser WebRTC call (no Twilio) — set when exposing Vast via ngrok for phone testing
# LOCAL_SERVER_URL=https://xxxx.ngrok-free.app

# Phone test (Twilio PSTN — real calls without ViciDial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Phone test (Telnyx TeXML — use with: python -m app.main --telnyx --dial +92...)
TELNYX_API_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_APPLICATION_SID=
TELNYX_PHONE_NUMBER=+1xxxxxxxxxx

# Public HTTPS URL from ngrok / cloudflare tunnel (telephony cannot hit localhost).
# On Vast GPU: run cloudflared tunnel --url http://127.0.0.1:10100 and paste the https URL here.
# Do NOT use http://VAST_IP:31359 — Telnyx media needs wss:// or audio will be choppy.
LOCAL_SERVER_URL=https://xxxx.trycloudflare.com

# GPU fleet supervisor (24/7 on your GPU box)
FLEET_MAX_WORKERS=3
FLEET_MEDIA_BASE_PORT=8800
SUPERVISOR_PORT=8770
GPU_SUPERVISOR_SECRET=
FLEET_POLL_SEC=20
FLEET_HEARTBEAT_SEC=30
# Telnyx bidirectional codec: PCMU (US G.711 μ-law). PCMA sounds garbled on US lines.
# TELNYX_STREAM_CODEC=PCMU
# Match Telnyx PCMU @ 8 kHz — avoids transcoding on the media stream.
TELEPHONY_PIPELINE_RATE=8000
TELNYX_STREAM_CODEC=PCMU
# Send each spoken line as one Telnyx media message (fixes choppy WS audio).
TELNYX_BULK_MEDIA=true
# TELNYX_ALLOW_INSECURE_WS=1   # debug only — ws:// via raw Vast port
