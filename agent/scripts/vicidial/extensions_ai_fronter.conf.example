; AI Fronter — Asterisk dialplan (copy to /etc/asterisk/extensions_custom.conf)
;
; Answered outbound: Local/9… ;1 → 138368@default → ai-fronter-route → EAGI (same channel).
; Do NOT Dial(Local/6666) for the customer — nested Local breaks EAGI audio to/from PSTN.
;
; Find VDAD ext: grep VDAD_local_optimize /etc/asterisk/extensions*.conf

[ai-fronter-route]
; AudioSocket replaces EAGI when fd 3 is not writable (CyburDial). Start bridge first:
;   ai-fronter-bridge.py --serve-audiosocket 6666
exten => s,1,NoOp(AI Fronter HIT — AudioSocket to GPU)
 same => n,Answer()
 same => n,Set(AI_UUID=${UUID()})
 same => n,GotoIf($[${LEN(${AI_UUID})}>0]?asok)
 same => n,Set(AI_UUID=${SHELL(uuidgen -r | tr -d '\n')})
 same => n(asok),AudioSocket(${AI_UUID},127.0.0.1:9092)
 same => n,Hangup()

[ai-fronter-agents]
; Manual test only: asterisk -rx "channel originate Local/6666@ai-fronter-agents application Wait 60"
exten => 6666,1,NoOp(AI Fronter bot 6666 manual test)
 same => n,Answer()
 same => n,EAGI(/usr/local/bin/ai-fronter-bridge.py,6666)
 same => n,Hangup()

[default]
exten => _9.,1,Goto(vicidial-auto-external,${EXTEN:1},1)

exten => 138368,1,NoOp(AI Fronter VDAD answered outbound to bot)
 same => n,AGI(agi-VDAD_local_optimize.agi,${EXTEN})
 same => n,Goto(ai-fronter-route,s,1)
 same => n,Hangup()

exten => 9600666,1,Goto(ai-fronter-route,s,1)
exten => 9606666,1,Goto(ai-fronter-route,s,1)
exten => 6666,1,Wait(3600)

[vicidial-auto]
exten => 9600666,1,Goto(ai-fronter-route,s,1)
exten => 9606666,1,Goto(ai-fronter-route,s,1)

[vicidial-auto-internal]
exten => 9600666,1,Goto(ai-fronter-route,s,1)
exten => 9606666,1,Goto(ai-fronter-route,s,1)

[vicidial-auto-external]
exten => _923XXXXXXXXX,1,AGI(agi://127.0.0.1:4577/call_log)
 same => n,Set(CALLERID(num)=+19482194316)
 same => n,Set(CALLERID(all)="+19482194316" <+19482194316>)
 same => n,Dial(SIP/${EXTEN}@TELNYX,60,To)
 same => n,Hangup()
